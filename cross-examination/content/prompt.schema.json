{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cross-examination:prompt:v3",
  "title": "Concrete counterexample prompt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "claim", "instruction", "scope", "starter", "category", "entries", "rejected", "matchTests", "sources", "editorial"],
  "properties": {
    "$schema": {"const": "../prompt.schema.json"},
    "schemaVersion": {"const": 3},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "claim": {"type": "string", "minLength": 10, "maxLength": 120},
    "instruction": {"type": "string", "minLength": 10, "maxLength": 160},
    "scope": {"type": "string", "minLength": 10, "maxLength": 320},
    "starter": {"$ref": "#/$defs/handle"},
    "category": {"type": "string", "minLength": 2, "maxLength": 40},
    "entries": {"type": "array", "minItems": 20, "maxItems": 10000, "items": {"$ref": "#/$defs/entry"}},
    "rejected": {"type": "array", "items": {"$ref": "#/$defs/rejected"}},
    "matchTests": {"type": "array", "minItems": 10, "maxItems": 20000, "items": {"$ref": "#/$defs/test"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "editorial": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "risks", "humanReviewRecommended"],
      "properties": {
        "summary": {"type": "string", "minLength": 20, "maxLength": 1200},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 10, "maxLength": 600}},
        "humanReviewRecommended": {"const": true}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 80},
    "handle": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^\\S+(?: \\S+){0,5}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "answer", "aliases", "points", "explanation", "sourceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "answer": {"$ref": "#/$defs/handle"},
        "aliases": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"$ref": "#/$defs/handle"}},
        "points": {"enum": [10, 25, 50, 75, 100]},
        "explanation": {"type": "string", "minLength": 20, "maxLength": 240},
        "sourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "rejected": {
      "type": "object", "additionalProperties": false,
      "required": ["answer", "aliases", "reason"],
      "properties": {
        "answer": {"$ref": "#/$defs/handle"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/handle"}},
        "reason": {"type": "string", "minLength": 15, "maxLength": 240}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "usedEntryIds", "expected"],
      "properties": {
        "input": {"type": "string", "maxLength": 300},
        "usedEntryIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "expected": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": {"enum": ["match", "suggestion", "ambiguous", "rejected", "invalid", "already-used", "no-match"]},
            "entryId": {"$ref": "#/$defs/id"}
          },
          "allOf": [{"if": {"properties": {"kind": {"enum": ["match", "suggestion", "already-used"]}}}, "then": {"required": ["entryId"]}, "else": {"not": {"required": ["entryId"]}}}]
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "accessedAt", "supports"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 3, "maxLength": 200},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "accessedAt": {"type": "string", "format": "date"},
        "supports": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    }
  }
}
