{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cross-examination:question:v2",
  "title": "Cross Examination question, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "version",
    "status",
    "question",
    "scope",
    "category",
    "startsWith",
    "rules",
    "entries",
    "matchTests",
    "sources",
    "editorial"
  ],
  "properties": {
    "$schema": {
      "const": "../question.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "playtest-ready",
        "example"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "scope": {
      "type": "string",
      "minLength": 10,
      "maxLength": 180
    },
    "category": {
      "enum": [
        "food",
        "everyday",
        "culture",
        "technology",
        "other"
      ]
    },
    "startsWith": {
      "enum": [
        "for",
        "against"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns",
        "maxWords",
        "maxCharacters",
        "multiplierBase"
      ],
      "properties": {
        "turns": {
          "const": 8
        },
        "maxWords": {
          "const": 4
        },
        "maxCharacters": {
          "const": 40
        },
        "multiplierBase": {
          "const": 2
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "matchTests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/matchTest"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "balanceNotes",
        "risks",
        "humanReviewRecommended"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800
        },
        "balanceNotes": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "humanReviewRecommended": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "playtest-ready"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 16,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "side": {
                      "const": "for"
                    }
                  }
                },
                "minContains": 8
              },
              {
                "contains": {
                  "properties": {
                    "side": {
                      "const": "against"
                    }
                  }
                },
                "minContains": 8
              }
            ]
          },
          "matchTests": {
            "minItems": 30
          }
        }
      }
    }
  ],
  "$defs": {
    "entryId": {
      "type": "string",
      "pattern": "^(for|against)_[a-z0-9]+(?:_[a-z0-9]+)*$",
      "maxLength": 64
    },
    "shortInput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^\\S+(?: \\S+){0,3}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "side",
        "answer",
        "aliases",
        "tier",
        "points",
        "reveal",
        "scoreRationale",
        "counters",
        "sourceIds",
        "standalone",
        "claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entryId"
        },
        "side": {
          "enum": [
            "for",
            "against"
          ]
        },
        "answer": {
          "$ref": "#/$defs/shortInput"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortInput"
          }
        },
        "tier": {
          "enum": [
            "obvious",
            "familiar",
            "clever",
            "deep-cut",
            "left-field"
          ]
        },
        "points": {
          "enum": [
            10,
            25,
            50,
            75,
            100
          ]
        },
        "reveal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 180
        },
        "scoreRationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 280
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/counter"
          }
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "standalone": {
          "type": "boolean"
        },
        "claims": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "side": {
                "const": "for"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^for_"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "side": {
                "const": "against"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^against_"
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "tier": {
                  "const": "obvious"
                },
                "points": {
                  "const": 10
                }
              }
            },
            {
              "properties": {
                "tier": {
                  "const": "familiar"
                },
                "points": {
                  "const": 25
                }
              }
            },
            {
              "properties": {
                "tier": {
                  "const": "clever"
                },
                "points": {
                  "const": 50
                }
              }
            },
            {
              "properties": {
                "tier": {
                  "const": "deep-cut"
                },
                "points": {
                  "const": 75
                }
              }
            },
            {
              "properties": {
                "tier": {
                  "const": "left-field"
                },
                "points": {
                  "const": 100
                }
              }
            }
          ]
        }
      ]
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "reveal",
        "rationale",
        "targetClaimId"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/entryId"
        },
        "reveal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 140
        },
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        },
        "targetClaimId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "matchTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "side",
        "usedEntryIds",
        "expected"
      ],
      "properties": {
        "input": {
          "type": "string",
          "maxLength": 300
        },
        "side": {
          "enum": [
            "for",
            "against"
          ]
        },
        "usedEntryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entryId"
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "match",
                "suggestion",
                "wrong-side",
                "already-used",
                "no-match",
                "ambiguous",
                "invalid",
                "wrong-context"
              ]
            },
            "entryId": {
              "$ref": "#/$defs/entryId"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "match",
                      "suggestion",
                      "wrong-side",
                      "already-used",
                      "wrong-context"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "entryId"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "entryId"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "fresh"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "targetId",
                "claimId"
              ],
              "properties": {
                "kind": {
                  "const": "counter"
                },
                "targetId": {
                  "$ref": "#/$defs/entryId"
                },
                "claimId": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "accessedAt",
        "supports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        },
        "supports": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        }
      }
    }
  }
}
